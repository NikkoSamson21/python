def solve_it(x, y, operation):
    if operation == 'add':
        return x + y
    elif operation == 'sub':
        return x - y
    elif operation == 'muli':
        return x * y
    elif operation == 'divi':
        return x / y
    else:
        return None  

x = int(input("Enter a number: "))
y = int(input("Enter a number: "))
operation = input("Enter the operation (add, sub, muli, divi): ")

result = solve_it(x, y, operation)

if result is not None:
    print("Result:", result)
else:
    print("Invalid operation. Please enter add, sub, muli, or divi.")
    
    
